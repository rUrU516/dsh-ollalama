{
  "name": "dsh-ollalama",
  "version": "0.1.0",
  "type": "module",
  "description": "Ollama Cloud balance and usage dashboard for DeepSeek Harness, with a draggable floating ring.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ollama",
    "dashboard",
    "usage"
  ],
  "author": "ruru516",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rUrU516/dsh-ollalama.git"
  },
  "homepage": "https://github.com/rUrU516/dsh-ollalama#readme",
  "bugs": {
    "url": "https://github.com/rUrU516/dsh-ollalama/issues"
  }
}
